# Copy to .env and fill in. .env is gitignored — never commit it.

# REQUIRED: absolute path to your Obsidian vault on the host
VAULT_HOST_PATH=/home/you/vault

# Host UID/GID so files written into the vault aren't root-owned
PUID=1000
PGID=1000

PORT=5557
TZ=Europe/London
OBSIDIAN_VAULT_NAME=Obsidian
SECRET_KEY=change-me-to-something-random

# Explicit one-time checkpoint bootstrap and weekly estate review only.
# Ordinary imports, downloads and upload compression use no AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Nightly deterministic checkpoint scan (legacy variable names retained).
AUTO_SUMMARY=true
AUTO_SUMMARY_HOUR=3

# Weekly Gemini estate review: Sunday at 04:00 in TZ.
WEEKLY_SYNTHESIS=true
WEEKLY_SYNTHESIS_DAY=sun
WEEKLY_SYNTHESIS_HOUR=4

HERALD_STATUS_EXPORT=true
HERALD_STATUS_HOUR=6
HERALD_STATUS_MINUTE=15
