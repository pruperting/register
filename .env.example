# Copy to .env and fill in. .env is gitignored — never commit it.

# REQUIRED: absolute path to your Obsidian vault on the host
VAULT_HOST_PATH=/home/you/vault

# Host UID/GID so files written into the vault aren't root-owned
PUID=1000
PGID=1000

PORT=5557
TZ=Europe/London
OBSIDIAN_VAULT_NAME=Obsidian
SECRET_KEY=change-me-to-something-random

# Summaries: "local" uses Ollama, "gemini" uses the API
SUMMARY_BACKEND=local
OLLAMA_URL=http://localhost:11434
LOCAL_CHAT_MODEL=qwen3:30b-a3b
OLLAMA_NUM_CTX=24576

# Only needed for SUMMARY_BACKEND=gemini, and for synthesise.py
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Nightly summary refresh
AUTO_SUMMARY=true
AUTO_SUMMARY_HOUR=3
AUTO_SUMMARY_MAX_PER_RUN=5
